{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "openapi": "node scripts/openapi.mjs && pnpm --filter @rental-fleet/contracts generate",
    "gps:retention": "tsx scripts/telematics/gps-retention.ts",
    "gps:poc": "tsx scripts/telematics/traccar-poc.ts",
    "gps:plans": "tsx scripts/telematics/query-plans.ts",
    "gps:retention:verify": "tsx scripts/telematics/retention-verify.ts",
    "platform:seed": "tsx scripts/platform-seed.ts",
    "evidence:storage": "tsx scripts/evidence-storage.ts provision",
    "evidence:cleanup": "tsx scripts/evidence-storage.ts cleanup",
    "evidence:retention": "tsx scripts/evidence-retention.ts"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@supabase/supabase-js": "2.116.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "ffmpeg-static": "5.3.0",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
