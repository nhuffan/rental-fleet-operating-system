APP_ENV=development
HOST=127.0.0.1
PORT=9000
WEB_ORIGIN=http://localhost:4000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only private inspection Storage and trusted administrator tasks; never sent to Web.
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
DATABASE_URL=
# Optional override; default resolves infra/certs/supabase-ca.crt.
# DATABASE_CA_PATH=
ALLOW_DEMO_SEED=false

# Optional: server-only, >=32 random characters. Empty disables trusted GPS ingestion.
GPS_TRACCAR_TOKEN=

# Inspection evidence budgets, enforced under the tenant lock. Optional defaults:
# EVIDENCE_MAX_IMAGES=8
# EVIDENCE_MAX_VIDEOS=1
# EVIDENCE_MAX_INSPECTION_BYTES=20971520
# EVIDENCE_MAX_TENANT_BYTES=134217728
# EVIDENCE_MAX_CONCURRENT_UPLOADS=3

# Attached media retention stays dry-run unless explicitly enabled on the exact development project.
EVIDENCE_RETENTION_DELETE_ENABLED=false

# Per-IP request limit per minute for each API process (10-100000). A gateway limit is still required.
# RATE_LIMIT_PER_MINUTE=300
# Set true only behind a trusted reverse proxy that appends the client address to X-Forwarded-For.
# TRUST_PROXY=false
