APP_ENV=development
HOST=127.0.0.1
PORT=9000
WEB_ORIGIN=http://localhost:4000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only private inspection Storage and trusted administrator tasks; never sent to Web.
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
DATABASE_URL=
# Optional override; default resolves infra/certs/supabase-ca.crt.
# DATABASE_CA_PATH=
ALLOW_DEMO_SEED=false

# Optional: server-only, >=32 random characters. Empty disables trusted GPS ingestion.
GPS_TRACCAR_TOKEN=

# Inspection evidence budgets, enforced under the tenant lock. Optional defaults:
# EVIDENCE_MAX_IMAGES=8
# EVIDENCE_MAX_VIDEOS=1
# EVIDENCE_MAX_INSPECTION_BYTES=20971520
# EVIDENCE_MAX_TENANT_BYTES=134217728
# EVIDENCE_MAX_CONCURRENT_UPLOADS=3

# Attached media retention stays dry-run unless explicitly enabled on the exact development project.
EVIDENCE_RETENTION_DELETE_ENABLED=false

# Per-IP request limit per minute for each API process (10-100000). A gateway limit is still required.
# RATE_LIMIT_PER_MINUTE=300
# Set true only behind a trusted reverse proxy that appends the client address to X-Forwarded-For.
# TRUST_PROXY=false

# Background jobs are OFF by default. Per-job mode: off | dry-run | apply (apply deletes data).
# JOBS_ENABLED=false
# JOB_GPS_RETENTION=off
# JOB_EVIDENCE_RETENTION=off
# JOB_INTERVAL_MINUTES=60
# JOB_MAX_TENANTS_PER_RUN=200
# Evidence deletion in staging/production also needs the project ref typed again:
# EVIDENCE_RETENTION_DELETE_CONFIRM=

# AI operations assistant (read-only; everything is off by default)
# AI_COPILOT_ENABLED=false
# AI_PROVIDER=none            # none | fake (dev/test only) | anthropic
# ANTHROPIC_API_KEY=          # server-side only; approve data processing first
# AI_MODEL=claude-sonnet-5-5
# AI_TIMEOUT_MS=20000
# AI_RATE_LIMIT_PER_MINUTE=10

# Local MCP over stdio (development only; `pnpm --filter api mcp:stdio` after build)
# MCP_ENABLED=false
# MCP_USER_ID=        # an existing active Owner user UUID of a disposable business
# MCP_BUSINESS_ID=    # that business UUID
